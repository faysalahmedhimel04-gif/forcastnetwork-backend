# Supabase Configuration for Backend
# Copy this to .env.local and fill with your Supabase project values
# Use a dedicated Supabase project for production

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key - ONLY for server-side admin operations (never expose to client)
# Use with caution - has full DB access bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Frontend URL for CORS in production
FRONTEND_URL=https://your-frontend-domain.com

# For local development
NODE_ENV=development